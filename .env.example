# Kopieer dit bestand naar .env en vul de waarden in.
# .env staat in .gitignore en hoort daar te blijven — deze sleutels zijn geheim.
#
# Bij deploy op Cloudflare zet je ze niet in .env maar als secret:
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put CONTACT_TO_EMAIL
# (of via het Cloudflare-dashboard onder Settings → Variables and Secrets)

# API-sleutel uit https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Afzender. Moet op een domein staan dat in Resend geverifieerd is
# (https://resend.com/domains), anders weigert de API de verzending.
# Voor een eerste test werkt onboarding@resend.dev — dat adres mag alleen
# mailen naar het e-mailadres van de Resend-account zelf.
RESEND_FROM="De Erfeniswijzer <noreply@erfeniswijzer.nl>"

# Waar de formulierinzendingen binnenkomen.
CONTACT_TO_EMAIL=info@erfeniswijzer.nl

# Optioneel. Publieke URL van de gids-PDF; die link komt in de bevestigingsmail
# te staan. Zolang deze leeg is, meldt de mail dat de gids persoonlijk wordt
# nagestuurd in plaats van een dode downloadknop te tonen.
GUIDE_DOWNLOAD_URL=

# Admin voor /admin. Kies een sterk wachtwoord en zet deze waarden lokaal in
# .env of als hosting secret. ADMIN_SESSION_SECRET mag een willekeurige lange
# geheime tekenreeks zijn; laat hem anders gelijk aan ADMIN_PASSWORD.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
